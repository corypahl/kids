{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kids-christmas",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false
}
